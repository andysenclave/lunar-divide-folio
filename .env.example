# Lunar Divide Folio - Environment Variables
# Copy this file to .env.local and fill in the values

# =============================================================================
# Vercel Blob Storage (Server-side only - keep secret!)
# =============================================================================
# Get this token from: Vercel Dashboard → Your Project → Storage → Blob → Settings
# For production: Set this in Vercel Dashboard → Settings → Environment Variables
BLOB_READ_WRITE_TOKEN=

# =============================================================================
# Public CDN Configuration (Exposed to browser - safe to commit)
# =============================================================================
# Base URL for all blob assets
NEXT_PUBLIC_BLOB_BASE_URL=

# CDN path prefixes (optional - defaults shown)
NEXT_PUBLIC_PORTRAITS_PATH=portraits
NEXT_PUBLIC_TEXTURES_PATH=textures
NEXT_PUBLIC_BADGES_PATH=badges
NEXT_PUBLIC_JOURNEY_PATH=journey
NEXT_PUBLIC_SHOWCASE_PATH=showcase
